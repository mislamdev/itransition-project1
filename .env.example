# The local environment of the application.
#
# Copy this file to ".env" and fill in what you need. The file is read in
# the development environment only (the dotenv-rails gem in the Gemfile);
# in production the variables come from the environment of the server (see
# docs/deployment/cloud66.md and docs/deployment/domcloud.md).
#
# ".env" is ignored by Git. Never commit real credentials.

# --- Database --------------------------------------------------------------
# DATABASE_URL always wins over config/database.yml.
#
# The query option "seeds=false" keeps db/seeds.rb out of a fresh database:
# the demo accounts of the seeds file have public passwords. Add it to every
# production URL.
DATABASE_URL=postgres://mislam@localhost/inventory_management_development

# The portable fallback without PostgreSQL (no full text search, the
# migrations are used instead of db/structure.sql).
# DB_ADAPTER=sqlite3

# Only used when DATABASE_URL is not set. The defaults are in
# config/database.yml.
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# DATABASE_USER=mislam
# DATABASE_PASSWORD=
# DATABASE_NAME=inventory_management_development
# TEST_DATABASE_NAME=inventory_management_test

# --- Server ----------------------------------------------------------------
# RAILS_ENV=development
# RACK_ENV=development
# The port of the Puma server. The local setup of the README uses 3123.
# PORT=3123
# RAILS_MAX_THREADS=5
# WEB_CONCURRENCY=1
# RAILS_LOG_LEVEL=debug

# --- Secrets ---------------------------------------------------------------
# Use one of RAILS_MASTER_KEY or SECRET_KEY_BASE.
RAILS_MASTER_KEY=
SECRET_KEY_BASE=

# --- Behind a TLS terminating proxy ----------------------------------------
# NGINX, Cloud 66 or a load balancer: the proxy sends "X-Forwarded-Proto:
# https" and the application has to believe it.
# ASSUME_SSL=true
# FORCE_SSL=true

# The public name of the application. It is used for the links in the
# emails and for the OAuth redirects.
# APP_HOST=stockroom.example.com
# APP_PROTOCOL=https

# The host names that are allowed to reach the application. Leave it empty
# to accept every host.
# APP_HOSTS=stockroom.example.com,www.stockroom.example.com

# --- Sign in with Google and Facebook (optional) ----------------------------
# A provider is only enabled when both values of its pair are present.
#
# The callback URLs of the local setup (the server runs on port 3123):
#   Google:   http://localhost:3123/auth/google_oauth2/callback
#   Facebook: http://localhost:3123/auth/facebook/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
