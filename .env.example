# Copy to .env for local overrides. Never commit real credentials.

# PostgreSQL (the development/test defaults are in config/database.yml).
DATABASE_URL=postgres://mislam@localhost/inventory_management_development

# Production secrets. Use one of RAILS_MASTER_KEY or SECRET_KEY_BASE.
RAILS_MASTER_KEY=
SECRET_KEY_BASE=

# Google OAuth callback URL: http://localhost:3000/auth/google_oauth2/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Facebook OAuth callback URL: http://localhost:3000/auth/facebook/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
