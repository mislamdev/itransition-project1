<% content_for :title, t("errors.forbidden_title", default: "Access denied · Stockroom") %>

<div class="container error-page">
  <section class="panel error-card" aria-labelledby="forbidden-heading">
    <div class="error-card__icon" aria-hidden="true">
      <svg viewBox="0 0 24 24">
        <rect x="5" y="10" width="14" height="10" rx="2" fill="none" stroke="currentColor" stroke-width="1.8"/>
        <path d="M8.5 10V7.5a3.5 3.5 0 0 1 7 0V10M12 14v2" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
      </svg>
    </div>
    <span class="eyebrow"><%= t("errors.forbidden_eyebrow", default: "403 · Forbidden") %></span>
    <h1 id="forbidden-heading"><%= t("errors.forbidden_heading", default: "You don’t have access to this page") %></h1>
    <p><%= local_assigns.fetch(:message, t("errors.forbidden", default: "You are not allowed to do that.")) %></p>
    <div class="error-card__actions">
      <a class="button button--primary" href="<%= root_path %>"><%= t("errors.back_home", default: "Back to dashboard") %></a>
      <button class="button button--secondary" type="button" data-go-back><%= t("errors.go_back", default: "Go back") %></button>
    </div>
  </section>
</div>
