# Environment variables for Stockroom on Cloud 66.
#
# Format: KEY=value, one per line. The dashboard accepts the same format
# (Settings -> Environment Variables -> Your Custom Variables) and the
# Toolbelt can upload the file:
#
#   cx env-vars upload --stack stockroom config/cloud66/env.vars.example
#
# Values are only applied on the next deployment. Never commit real secrets
# to the repository: this file is a template.

# --- Application -----------------------------------------------------------
RAILS_ENV=production
RAILS_LOG_LEVEL=info

# Cloud 66 replaces "AUTO_GENERATE_64" with a random 64 character string on
# every deployment.
SECRET_KEY_BASE=AUTO_GENERATE_64

# Threads per Puma worker and the number of workers. Keep
# replicas x WEB_CONCURRENCY x RAILS_MAX_THREADS below the max_connections
# of the PostgreSQL server.
RAILS_MAX_THREADS=5
WEB_CONCURRENCY=2

# --- Database --------------------------------------------------------------
# Use the URL that Cloud 66 generated for the managed PostgreSQL server and
# append "?seeds=false": a fresh database must not be filled with the demo
# accounts of db/seeds.rb.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/inventory_management_production?seeds=false

# --- TLS and host names ----------------------------------------------------
# Cloud 66 terminates TLS in Nginx and forwards plain HTTP to the
# application, so Rails has to be told that the request was secure.
ASSUME_SSL=true
FORCE_SSL=true

# The public host name of the application.
APP_HOST=stockroom.example.com
APP_PROTOCOL=https

# Optional: the host names that are allowed to reach the application.
# Leave it empty to accept every host.
APP_HOSTS=stockroom.example.com,www.stockroom.example.com

# --- Sign in with Google and Facebook (optional) ---------------------------
# The providers are only enabled when both values of a pair are present.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# --- Encrypted credentials (optional) --------------------------------------
# Only needed when config/credentials.yml.enc is used. Without it the
# application uses SECRET_KEY_BASE only.
RAILS_MASTER_KEY=
