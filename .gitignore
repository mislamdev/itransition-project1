# See https://help.github.com/articles/ignoring-files for more about ignoring files.

# Temporary files generated by your text editor or operating system.
.DS_Store
*.swp
*~

# Ignore bundler configuration and locally installed gems.
.bundle/
.home/
vendor/gems/
vendor/bundle/

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep
!/tmp/pids/
!/tmp/pids/.keep
/tmp/pids/*.pid
/tmp/storage/

# Ignore master key for decrypting credentials and more.
/config/master.key

# Ignore environment files and local database dumps.
/.env*
!/.env.example
*.sqlite3
*.sqlite3-*
/storage/

# Ignore test and coverage output.
/coverage/
/test/tmp/
/test/screenshots/
/test/videos/

# Ignore deployment files generated by Kamal.
/config/deploy.yml
/.kamal/

# Ignore editor and OS metadata.
.idea/
.vscode/
